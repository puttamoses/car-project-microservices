// ─────────────────────────────────────────────────────────────
//  car-frontend — CD Pipeline (GitOps)
//
//  Triggered by: CI pipeline post { success }
//  Input:        IMAGE_URI from CI
//
//  How it works:
//    1. Clones GitHub repo
//    2. Updates image in k8s/frontend-deployment.yaml
//    3. Commits and pushes to GitHub
//    4. ArgoCD detects the change → syncs to EKS automatically
//
//  ✅ Jenkins Setup Required:
//    Manage Jenkins → Credentials
//      → github-creds  Username+Password (PAT as password)
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    parameters {
        string(
            name        : 'IMAGE_URI',
            defaultValue: '',
            description : 'Full ECR image URI passed from CI pipeline'
        )
    }

    environment {
        IMAGE_URI     = "${params.IMAGE_URI}"
        GITHUB_REPO   = 'https://github.com/puttamoses/car-project-microservices.git'
        GITHUB_BRANCH = 'main'
        DEPLOY_FILE   = 'k8s/frontend-deployment.yaml'
    }

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Stage 1 | Update K8s YAML & Push to GitHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId   : 'github-creds',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh '''
                        rm -rf gitops-repo
                        git clone https://${GIT_USER}:${GIT_PASS}@github.com/puttamoses/car-project-microservices.git gitops-repo
                        cd gitops-repo

                        git config user.email "jenkins-ci@autoelite.com"
                        git config user.name  "Jenkins CI"

                        echo "Current image:"
                        grep "image:" ${DEPLOY_FILE}

                        sed -i "s|image:.*car-frontend.*|image: ${IMAGE_URI}|g" ${DEPLOY_FILE}

                        echo "Updated image:"
                        grep "image:" ${DEPLOY_FILE}

                        git add ${DEPLOY_FILE}
                        git commit -m "cd: update car-frontend image to ${IMAGE_URI} [build ${BUILD_NUMBER}]"
                        git push origin ${GITHUB_BRANCH}

                        echo "✅ Pushed — ArgoCD will sync automatically"
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ CD complete — ArgoCD will deploy ${IMAGE_URI}"
        }
        failure {
            echo '❌ CD failed — YAML not updated'
        }
        always {
            sh 'rm -rf gitops-repo || true'
            cleanWs()
        }
    }

}
