pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_URI',
            description: 'ECR image URI for frontend'
        )
    }

    environment {
        GIT_REPO    = 'git@github.com:your-org/autoelite.git'
        BRANCH      = 'main'
        DEPLOY_FILE = 'k8s/frontend-deployment.yaml'
        IMAGE_URI   = "${params.IMAGE_URI}"
        GIT_DIR     = 'autoelite'
    }

    stages {

        stage('Checkout GitOps Repo') {
            steps {
                sh '''
                    rm -rf ${GIT_DIR}
                    git clone -b ${BRANCH} ${GIT_REPO}
                '''
            }
        }

        stage('Update Frontend Image') {
            steps {
                dir("${GIT_DIR}") {
                    sh '''
                        echo "🔄 Updating frontend image"

                        sed -i "s|image: .*frontend.*|image: ${IMAGE_URI}|g" ${DEPLOY_FILE}

                        echo "✅ Updated frontend deployment:"
                        cat ${DEPLOY_FILE}
                    '''
                }
            }
        }

        stage('Commit & Push') {
            steps {
                dir("${GIT_DIR}") {
                    withCredentials([usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh '''
                            git config user.email "ci@autoelite.com"
                            git config user.name "jenkins-ci"

                            git add .
                            git commit -m "🚀 Frontend image update: ${IMAGE_URI}" || echo "No changes"

                            git push https://${GIT_USER}:${GIT_PASS}@github.com/your-org/autoelite.git ${BRANCH}
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Frontend CD done — ArgoCD will sync automatically"
        }
        failure {
            echo "❌ Frontend CD failed"
        }
    }
}
