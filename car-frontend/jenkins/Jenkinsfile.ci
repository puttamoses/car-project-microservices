// ─────────────────────────────────────────────────────────────
//  car-frontend — CI Pipeline
//
//  Stage 1  — Checkout
//  Stage 2  — Build      (injects REACT_APP_API_URL from Jenkins)
//  Stage 3  — Test + Coverage
//  Stage 4  — SCA  (OWASP Dependency-Check)
//  Stage 5  — SAST (SonarQube)
//  Stage 6  — Quality Gate HARD STOP
//  Stage 7  — Docker Build
//  Stage 8  — Trivy Scan HARD STOP
//  Stage 9  — Smoke Test
//  Stage 10 — Push to ECR
//  Stage 11 — Upload Reports to S3
//
//  ✅ Jenkins one-time setup:
//    Global Tool Config → NodeJS-20, OWASP-DC
//    Configure System   → SonarQube server named "SonarQube"
//    Credentials        → sonar-token, aws-account-id,
//                         react-app-api-url
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        // ✅ FIXED: removed hardcoded IP — SONAR_HOST_URL is injected
        //           by withSonarQubeEnv('SonarQube') at runtime.
        AWS_REGION        = 'ap-south-1'
        S3_BUCKET         = 'your-reports-bucket'

        SONAR_TOKEN       = credentials('sonar-token')
        AWS_ACCOUNT_ID    = credentials('aws-account-id')
        REACT_APP_API_URL = credentials('react-app-api-url')

        ECR_REPOSITORY    = 'car-frontend'
        IMAGE_TAG         = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────
        // STAGE 1 — Checkout
        // ─────────────────────────────────────────────────────
        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 2 — Build
        // ─────────────────────────────────────────────────────
        stage('Stage 2 | Build') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm install
                        echo "REACT_APP_API_URL=${REACT_APP_API_URL}" > .env.production
                        npm run build
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 3 — Test + Coverage
        // ─────────────────────────────────────────────────────
        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm test -- \
                            --coverage \
                            --watchAll=false \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=clover \
                            --ci
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'car-frontend/coverage/junit.xml'
                    publishHTML([
                        allowMissing         : false,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'car-frontend/coverage/lcov-report',
                        reportFiles          : 'index.html',
                        reportName           : 'Frontend Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 4 — SCA (OWASP Dependency-Check)
        // ─────────────────────────────────────────────────────
        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                sh 'mkdir -p car-frontend/dependency-check-report'
                dependencyCheck(
                    odcInstallation: 'OWASP-DC',
                    additionalArguments: '''
                        --project car-frontend
                        --scan car-frontend
                        --format XML
                        --format HTML
                        --format JSON
                        --out car-frontend/dependency-check-report
                        --exclude "**/.git/**"
                        --exclude "**/node_modules/**"
                        --exclude "**/build/**"
                        --exclude "**/coverage/**"
                        --exclude "**/dependency-check-report/**"
                        --failOnCVSS 9
                        --disableAssembly
                        --disableNodeAudit
                    '''
                )
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'car-frontend/dependency-check-report/dependency-check-report.xml'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 5 — SAST (SonarQube)
        // ─────────────────────────────────────────────────────
        stage('Stage 5 | SAST — SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        cd car-frontend && npx sonar-scanner \
                            -Dsonar.projectKey=car-frontend \
                            -Dsonar.projectName="Car Frontend" \
                            -Dsonar.projectVersion=${BUILD_NUMBER} \
                            -Dsonar.sources=src \
                            -Dsonar.exclusions=node_modules/**,build/**,coverage/**,**/*.test.js,**/*.test.jsx,dependency-check-report/** \
                            -Dsonar.tests=src \
                            -Dsonar.test.inclusions=**/*.test.js,**/*.test.jsx \
                            -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                            -Dsonar.dependencyCheck.jsonReportPath=dependency-check-report/dependency-check-report.json \
                            -Dsonar.dependencyCheck.htmlReportPath=dependency-check-report/dependency-check-report.html \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=${SONAR_TOKEN}
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 6 — Quality Gate HARD STOP
        // ─────────────────────────────────────────────────────
        stage('Stage 6 | Quality Gate — HARD STOP') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        def taskId = readFile('car-frontend/.scannerwork/report-task.txt')
                            .split('\n')
                            .find { it.startsWith('ceTaskId=') }
                            ?.replace('ceTaskId=', '')
                            ?.trim()

                        if (!taskId) error('ceTaskId not found in report-task.txt')
                        echo "Polling SonarQube task: ${taskId}"

                        withCredentials([
                            string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN_VAL')
                        ]) {
                            timeout(time: 10, unit: 'MINUTES') {
                                def analysisId = ""

                                while (true) {
                                    sleep 10

                                    def resp = sh(
                                        script: """
                                            curl -s -u "\$SONAR_TOKEN_VAL:" \
                                            "\$SONAR_HOST_URL/api/ce/task?id=${taskId}"
                                        """,
                                        returnStdout: true
                                    ).trim()

                                    echo "CE Task Response: ${resp}"

                                    writeFile file: '/tmp/sonar-task.json', text: resp

                                    def taskStatus = sh(
                                        script: "jq -r '.task.status' /tmp/sonar-task.json",
                                        returnStdout: true
                                    ).trim()

                                    echo "SonarQube task status: ${taskStatus}"

                                    if (taskStatus == "SUCCESS") {
                                        analysisId = sh(
                                            script: "jq -r '.task.analysisId' /tmp/sonar-task.json",
                                            returnStdout: true
                                        ).trim()
                                        break
                                    }

                                    if (taskStatus == "FAILED" || taskStatus == "CANCELLED") {
                                        error("SonarQube task failed: ${taskStatus}")
                                    }
                                }

                                echo "Analysis ID: ${analysisId}"
                                sleep 5

                                def gateResp = sh(
                                    script: """
                                        curl -s -u "\$SONAR_TOKEN_VAL:" \
                                        "\$SONAR_HOST_URL/api/qualitygates/project_status?analysisId=${analysisId}"
                                    """,
                                    returnStdout: true
                                ).trim()

                                echo "Quality Gate Response: ${gateResp}"

                                writeFile file: '/tmp/sonar-gate.json', text: gateResp

                                def gateStatus = sh(
                                    script: "jq -r '.projectStatus.status' /tmp/sonar-gate.json",
                                    returnStdout: true
                                ).trim()

                                echo "Quality Gate Status: ${gateStatus}"

                                if (gateStatus != "OK") {
                                    error("""
QUALITY GATE FAILED: ${gateStatus}
Dashboard: ${SONAR_HOST_URL}/dashboard?id=car-frontend
                                    """)
                                }

                                echo '✅ Quality Gate PASSED'
                            }
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 7 — Docker Build
        // ─────────────────────────────────────────────────────
        stage('Stage 7 | Docker Build') {
            steps {
                script {
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI    = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    sh "docker build -t ${env.IMAGE_URI} car-frontend/"
                }
                echo "Built: ${env.IMAGE_URI}"
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 8 — Trivy Scan HARD STOP
        // ─────────────────────────────────────────────────────
        stage('Stage 8 | Trivy Scan — HARD STOP') {
            steps {
                script {
                    sh """
                        trivy image \
                            --severity HIGH,CRITICAL \
                            --exit-code 1 \
                            --ignore-unfixed \
                            --no-progress \
                            --format json \
                            --output trivy-report.json \
                            ${env.IMAGE_URI}
                    """
                }
                echo '✅ Trivy scan passed'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 9 — Smoke Test
        // ─────────────────────────────────────────────────────
        stage('Stage 9 | Smoke Test') {
            steps {
                script {
                    sh """
                        set -e

                        echo "Cleaning old containers on port 9090..."
                        docker ps -q --filter "publish=9090" | xargs -r docker rm -f || true

                        docker run -d \
                            --name frontend-smoke-${BUILD_NUMBER} \
                            -p 9090:80 \
                            ${env.IMAGE_URI}

                        sleep 10

                        STATUS=\$(curl -o /dev/null -sw "%{http_code}" http://localhost:9090/)
                        [ "\$STATUS" = "200" ] && echo "Root OK" || exit 1

                        curl -sf http://localhost:9090/ | grep -q 'id="root"' \
                            && echo "React app served" || exit 1

                        STATUS=\$(curl -o /dev/null -sw "%{http_code}" http://localhost:9090/cars)
                        [ "\$STATUS" = "200" ] && echo "React Router OK" || exit 1

                        echo "✅ Smoke test passed"
                    """
                }
            }
            post {
                always {
                    sh "docker rm -f frontend-smoke-${BUILD_NUMBER} || true"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 10 — Push to ECR
        // FIX: switched single-quotes to double-quotes so Groovy
        //      interpolates env.ECR_REGISTRY and env.IMAGE_URI
        // ─────────────────────────────────────────────────────
        stage('Stage 10 | Push to ECR') {
            steps {
                script {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin \
                                ${env.ECR_REGISTRY}

                        docker tag \
                            ${env.IMAGE_URI} \
                            ${env.ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        docker push ${env.IMAGE_URI}

                        docker push \
                            ${env.ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        echo ${env.IMAGE_URI} > /tmp/frontend_image_uri.txt
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 11 — Upload Reports to S3
        // ─────────────────────────────────────────────────────
        stage('Stage 11 | Upload Reports to S3') {
            steps {
                sh '''
                    R="car-frontend/build-${BUILD_NUMBER}"

                    [ -f trivy-report.json ] && \
                        aws s3 cp trivy-report.json \
                            s3://${S3_BUCKET}/${R}/trivy-report.json \
                        || echo "trivy-report.json not found, skipping"

                    [ -d car-frontend/dependency-check-report ] && \
                        aws s3 cp car-frontend/dependency-check-report/ \
                            s3://${S3_BUCKET}/${R}/sca/ --recursive \
                        || echo "OWASP report dir not found, skipping"

                    [ -f car-frontend/coverage/lcov.info ] && \
                        aws s3 cp car-frontend/coverage/lcov.info \
                            s3://${S3_BUCKET}/${R}/coverage/lcov.info \
                        || echo "lcov.info not found, skipping"

                    echo "✅ Reports upload complete → s3://${S3_BUCKET}/${R}/"
                '''
            }
        }

    } // end stages

    post {

        success {
            script {
                def imageUri = sh(
                    script: 'cat /tmp/frontend_image_uri.txt',
                    returnStdout: true
                ).trim()

                echo "✅ CI passed — triggering CD with: ${imageUri}"

                build(
                    job: 'car-frontend-cd',
                    wait: false,
                    propagate: false,
                    parameters: [
                        string(
                            name: 'IMAGE_URI',
                            value: imageUri
                        )
                    ]
                )
            }
        }

        failure {
            echo '❌ CI failed — CD will NOT be triggered'
        }

        always {
            sh 'docker image prune -f || true'
            sh 'rm -f /tmp/frontend_image_uri.txt trivy-report.json || true'
            cleanWs()
        }

    } // end post

} // end pipeline
