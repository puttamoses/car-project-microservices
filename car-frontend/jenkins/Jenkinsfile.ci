// ─────────────────────────────────────────────────────────────
//  car-frontend — CI Pipeline
//
//  Stage 1  — Checkout
//  Stage 2  — Build                  (injects REACT_APP_API_URL)
//  Stage 3  — Test + Coverage        (60% threshold)
//  Stage 4  — SCA — OWASP            (Jenkins Tool — no manual install)
//  Stage 5  — SAST — SonarQube       (source code security scan)
//  Stage 6  — Quality Gate           (HARD STOP)
//  Stage 7  — Docker Build
//  Stage 8  — Trivy Image Scan       (HARD STOP)
//  Stage 9  — Smoke Test
//  Stage 10 — Push to ECR
//  Stage 11 — Upload Reports to S3
//
//  ✅ Jenkins One-Time Setup:
//    Manage Jenkins → Global Tool Configuration
//      NodeJS       → Name: NodeJS-20        → Install automatically
//      Dep-Check    → Name: OWASP-DC         → Install automatically
//    Manage Jenkins → Configure System
//      SonarQube    → Name: SonarQube        → URL + Token
//    Manage Jenkins → Credentials
//      sonar-token          Secret Text
//      aws-credentials      AWS Credentials
//      aws-account-id       Secret Text
//      react-app-api-url    Secret Text  (backend ALB DNS)
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        SONAR_HOST_URL    = 'http://your-sonar-server:9000'  // ✅ your SonarQube URL
        AWS_REGION        = 'ap-south-1'                     // ✅ your AWS region
        S3_BUCKET         = 'your-reports-bucket'            // ✅ your S3 bucket name

        SONAR_TOKEN       = credentials('sonar-token')
        AWS_ACCOUNT_ID    = credentials('aws-account-id')
        REACT_APP_API_URL = credentials('react-app-api-url') // ✅ backend ALB DNS

        ECR_REPOSITORY    = 'car-frontend'
        IMAGE_TAG         = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
                echo "Branch: ${env.BRANCH_NAME}"
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 2 — Build
        // Injects backend URL from Jenkins credential into
        // .env.production before npm run build.
        // React bakes it into the JS bundle at build time.
        // ─────────────────────────────────────────────────────
        stage('Stage 2 | Build') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm install
                        echo "REACT_APP_API_URL=${REACT_APP_API_URL}" > .env.production
                        npm run build
                        echo "Build complete"
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 3 — Test + Coverage
        // ─────────────────────────────────────────────────────
        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm test -- \
                            --coverage \
                            --watchAll=false \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=clover \
                            --coverageThreshold='{"global":{"branches":60,"functions":60,"lines":60,"statements":60}}' \
                            --ci
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'car-frontend/coverage/junit.xml'

                    publishHTML([
                        allowMissing         : false,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'car-frontend/coverage/lcov-report',
                        reportFiles          : 'index.html',
                        reportName           : 'Frontend Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 4 — SCA (OWASP Dependency-Check)
        //
        // Uses Jenkins Global Tool — NO manual install needed.
        // ✅ One-time setup:
        //    Manage Jenkins → Global Tool Configuration
        //    → Dependency-Check → Add → Name: OWASP-DC
        //    → Install automatically ✅ → Save
        // ─────────────────────────────────────────────────────
        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                dir('car-frontend') {
                    dependencyCheck(
                        additionalArguments: [
                            '--project "car-frontend"',
                            '--scan .',
                            '--exclude "**/.git/**"',
                            '--exclude "**/build/**"',
                            '--exclude "**/coverage/**"',
                            '--exclude "**/dependency-check-report/**"',
                            '--format XML',
                            '--format HTML',
                            '--format JSON',
                            '--out dependency-check-report',
                            '--failOnCVSS 9',
                            '--enableRetired',
                            '--disableAssembly',
                            '--disableNodeAudit',
                            '--nodePackageSkipDevDependencies'
                        ].join(' '),
                        odcInstallation: 'OWASP-DC'
                    )
                }
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'car-frontend/dependency-check-report/dependency-check-report.xml'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 5 — SAST (SonarQube)
        // ─────────────────────────────────────────────────────
        stage('Stage 5 | SAST — SonarQube Scan') {
            steps {
                dir('car-frontend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            npx sonar-scanner \
                                -Dsonar.projectKey=car-frontend \
                                -Dsonar.projectName="Car Frontend" \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                -Dsonar.sources=src \
                                -Dsonar.exclusions=node_modules/**,build/**,coverage/**,**/*.test.js,**/*.test.jsx,dependency-check-report/** \
                                -Dsonar.tests=src \
                                -Dsonar.test.inclusions=**/*.test.js,**/*.test.jsx \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                -Dsonar.dependencyCheck.jsonReportPath=dependency-check-report/dependency-check-report.json \
                                -Dsonar.dependencyCheck.htmlReportPath=dependency-check-report/dependency-check-report.html \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 6 — Quality Gate (HARD STOP)
        // ─────────────────────────────────────────────────────
        stage('Stage 6 | Quality Gate — HARD STOP') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 7 — Docker Build
        // ─────────────────────────────────────────────────────
        stage('Stage 7 | Docker Build') {
            steps {
                dir('car-frontend') {
                    script {
                        env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        env.IMAGE_URI    = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    }
                    sh 'docker build -t ${IMAGE_URI} .'
                    echo "Built: ${env.IMAGE_URI}"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 8 — Trivy Image Scan (HARD STOP)
        // ─────────────────────────────────────────────────────
        stage('Stage 8 | Trivy Image Scan — HARD STOP') {
            steps {
                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_URI}

                    echo "✅ Trivy scan passed"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 9 — Smoke Test
        // ─────────────────────────────────────────────────────
        stage('Stage 9 | Smoke Test') {
            steps {
                sh '''
                    docker run -d \
                        --name frontend-smoke-${BUILD_NUMBER} \
                        -p 8080:80 \
                        ${IMAGE_URI}

                    sleep 10

                    STATUS=$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/)
                    [ "$STATUS" = "200" ] && echo "✅ Root OK" || exit 1

                    curl -sf http://localhost:8080/ | grep -q "root" \
                        && echo "✅ React app served" || exit 1

                    STATUS=$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/cars)
                    [ "$STATUS" = "200" ] && echo "✅ React Router OK" || exit 1

                    echo "✅ Smoke test passed"
                '''
            }
            post {
                always {
                    sh "docker rm -f frontend-smoke-${BUILD_NUMBER} || true"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 10 — Push to ECR
        // ─────────────────────────────────────────────────────
        stage('Stage 10 | Push to ECR') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin \
                                ${ECR_REGISTRY}

                        docker tag ${IMAGE_URI} ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        docker push ${IMAGE_URI}
                        docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        echo "✅ Pushed: ${IMAGE_URI}"
                        echo "${IMAGE_URI}" > /tmp/frontend_image_uri.txt
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 11 — Upload Reports to S3
        // ─────────────────────────────────────────────────────
        stage('Stage 11 | Upload Reports to S3') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        REPORT_PATH="car-frontend/build-${BUILD_NUMBER}"

                        aws s3 cp trivy-report.json \
                            s3://${S3_BUCKET}/${REPORT_PATH}/trivy-report.json \
                            || echo "trivy-report not found, skipping"

                        aws s3 cp car-frontend/dependency-check-report/ \
                            s3://${S3_BUCKET}/${REPORT_PATH}/sca/ \
                            --recursive \
                            || echo "sca reports not found, skipping"

                        aws s3 cp car-frontend/coverage/lcov.info \
                            s3://${S3_BUCKET}/${REPORT_PATH}/coverage/lcov.info \
                            || echo "lcov not found, skipping"

                        echo "✅ Reports uploaded to s3://${S3_BUCKET}/${REPORT_PATH}/"
                    '''
                }
            }
        }

    }

    post {
        success {
            script {
                def imageUri = sh(
                    script: 'cat /tmp/frontend_image_uri.txt',
                    returnStdout: true
                ).trim()
                echo "✅ CI passed — triggering CD with: ${imageUri}"
                build job: 'car-frontend-cd',
                      parameters: [string(name: 'IMAGE_URI', value: imageUri)],
                      wait: false
            }
        }
        failure {
            echo '❌ CI failed — CD will NOT be triggered'
        }
        always {
            sh 'docker image prune -f || true'
            sh 'rm -f /tmp/frontend_image_uri.txt trivy-report.json || true'
            cleanWs()
        }
    }

}
