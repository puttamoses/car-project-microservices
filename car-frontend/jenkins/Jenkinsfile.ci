// ─────────────────────────────────────────────────────────────
//  car-frontend — CI Pipeline
//
//  Stage 1  — Checkout
//  Stage 2  — Build      (injects REACT_APP_API_URL from Jenkins)
//  Stage 3  — Test + Coverage
//  Stage 4  — SCA  (OWASP Dependency-Check)
//  Stage 5  — SAST (SonarQube)
//  Stage 6  — Quality Gate HARD STOP
//  Stage 7  — Docker Build
//  Stage 8  — Trivy Scan HARD STOP
//  Stage 9  — Smoke Test
//  Stage 10 — Push to ECR
//  Stage 11 — Upload Reports to S3
//
//  ✅ Jenkins one-time setup:
//    Global Tool Config → NodeJS-20, OWASP-DC
//    Configure System   → SonarQube server named "SonarQube"
//    Credentials        → sonar-token, aws-credentials,
//                         aws-account-id, react-app-api-url
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        SONAR_HOST_URL    = 'http://13.200.38.79:9000'
        AWS_REGION        = 'ap-south-1'
        S3_BUCKET         = 'your-reports-bucket'

        SONAR_TOKEN       = credentials('sonar-token')
        AWS_ACCOUNT_ID    = credentials('aws-account-id')
        REACT_APP_API_URL = credentials('react-app-api-url')

        ECR_REPOSITORY    = 'car-frontend'
        IMAGE_TAG         = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────
        // STAGE 1 — Checkout
        // ─────────────────────────────────────────────────────
        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 2 — Build
        //
        // Writes REACT_APP_API_URL (backend ALB DNS) into
        // .env.production before npm run build.
        // React reads it at build time and bakes it into
        // the JS bundle — this is how frontend calls backend.
        // ─────────────────────────────────────────────────────
        stage('Stage 2 | Build') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm install
                        echo "REACT_APP_API_URL=${REACT_APP_API_URL}" > .env.production
                        npm run build
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 3 — Test + Coverage
        //
        // Generates coverage/lcov.info → imported by SonarQube
        // Generates coverage/junit.xml → Jenkins test chart
        // ─────────────────────────────────────────────────────
        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm test -- \
                            --coverage \
                            --watchAll=false \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=clover \
                            --ci
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'car-frontend/coverage/junit.xml'
                    publishHTML([
                        allowMissing         : false,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'car-frontend/coverage/lcov-report',
                        reportFiles          : 'index.html',
                        reportName           : 'Frontend Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 4 — SCA (OWASP Dependency-Check)
        //
        // IMPORTANT: dependencyCheck() always runs from WORKSPACE.
        // dir() does NOT change its working directory.
        // All paths must be relative to WORKSPACE.
        //
        // --scan car-frontend        → scans car-frontend folder
        // --out  car-frontend/dep..  → saves reports there
        //
        // mkdir -p MUST be before dependencyCheck() call.
        //
        // ✅ One-time Jenkins setup:
        //    Manage Jenkins → Global Tool Configuration
        //    → Dependency-Check → Add → Name: OWASP-DC
        //    → Install automatically ✅ → Save
        // ─────────────────────────────────────────────────────
        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                sh 'mkdir -p car-frontend/dependency-check-report'
                dependencyCheck(
                    odcInstallation: 'OWASP-DC',
                    additionalArguments: '--project car-frontend --scan car-frontend --exclude "**/.git/**" --exclude "**/node_modules/**" --exclude "**/build/**" --exclude "**/coverage/**" --exclude "**/dependency-check-report/**" --format XML --format HTML --format JSON --out car-frontend/dependency-check-report --failOnCVSS 9 --disableAssembly --disableNodeAudit'
                )
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'car-frontend/dependency-check-report/dependency-check-report.xml'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 5 — SAST (SonarQube)
        //
        // sonar-scanner runs from WORKSPACE root.
        // sonar.sources=src is relative to car-frontend folder.
        // All report paths are relative to car-frontend folder.
        // ─────────────────────────────────────────────────────
        stage('Stage 5 | SAST — SonarQube Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        cd car-frontend && npx sonar-scanner \
                            -Dsonar.projectKey=car-frontend \
                            -Dsonar.projectName="Car Frontend" \
                            -Dsonar.projectVersion=${BUILD_NUMBER} \
                            -Dsonar.sources=src \
                            -Dsonar.exclusions=node_modules/**,build/**,coverage/**,**/*.test.js,**/*.test.jsx,dependency-check-report/** \
                            -Dsonar.tests=src \
                            -Dsonar.test.inclusions=**/*.test.js,**/*.test.jsx \
                            -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                            -Dsonar.dependencyCheck.jsonReportPath=dependency-check-report/dependency-check-report.json \
                            -Dsonar.dependencyCheck.htmlReportPath=dependency-check-report/dependency-check-report.html \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=${SONAR_TOKEN}
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 6 — Quality Gate HARD STOP
        //
        // report-task.txt is inside car-frontend/.scannerwork/
        // because sonar-scanner ran from car-frontend/ (cd first)
        // ─────────────────────────────────────────────────────
        stage('Stage 6 | Quality Gate — HARD STOP') {
            steps {
                script {
                    def taskId = readFile('car-frontend/.scannerwork/report-task.txt')
                        .split('\n')
                        .find { it.startsWith('ceTaskId=') }
                        ?.replace('ceTaskId=', '')
                        ?.trim()

                    if (!taskId) error('ceTaskId not found in report-task.txt')
                    echo "Polling SonarQube task: ${taskId}"

                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN_VAL')]) {
                        timeout(time: 10, unit: 'MINUTES') {
                            waitUntil(initialRecurrencePeriod: 10000) {
                                def resp = sh(
                                    script: "curl -sf -u \"\$SONAR_TOKEN_VAL:\" \"${SONAR_HOST_URL}/api/ce/task?id=${taskId}\"",
                                    returnStdout: true
                                ).trim()

                                def taskStatus = readJSON(text: resp).task.status
                                echo "SonarQube task status: ${taskStatus}"

                                if (taskStatus == 'PENDING' || taskStatus == 'IN_PROGRESS') return false
                                if (taskStatus != 'SUCCESS') error("SonarQube task failed: ${taskStatus}")

                                def analysisId = readJSON(text: resp).task.analysisId
                                def gateResp = sh(
                                    script: "curl -sf -u \"\$SONAR_TOKEN_VAL:\" \"${SONAR_HOST_URL}/api/qualitygates/project_status?analysisId=${analysisId}\"",
                                    returnStdout: true
                                ).trim()

                                def gateStatus = readJSON(text: gateResp).projectStatus.status
                                echo "Quality Gate: ${gateStatus}"

                                if (gateStatus != 'OK') {
                                    error("Quality Gate FAILED: ${gateStatus} — see ${SONAR_HOST_URL}/dashboard?id=car-frontend")
                                }

                                echo '✅ Quality Gate PASSED'
                                return true
                            }
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 7 — Docker Build
        // ─────────────────────────────────────────────────────
        stage('Stage 7 | Docker Build') {
            steps {
                script {
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI    = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    sh "docker build -t ${env.IMAGE_URI} car-frontend/"
                }
                echo "Built: ${env.IMAGE_URI}"
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 8 — Trivy Scan HARD STOP
        // ─────────────────────────────────────────────────────
        stage('Stage 8 | Trivy Scan — HARD STOP') {
            steps {
                script {
                    sh """
                        trivy image \
                            --severity HIGH,CRITICAL \
                            --exit-code 1 \
                            --ignore-unfixed \
                            --no-progress \
                            --format json \
                            --output trivy-report.json \
                            ${env.IMAGE_URI}
                    """
                }
                echo '✅ Trivy scan passed'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 9 — Smoke Test
        // ─────────────────────────────────────────────────────
        stage('Stage 9 | Smoke Test') {
            steps {
                script {
                    sh """
                        docker run -d \
                            --name frontend-smoke-${BUILD_NUMBER} \
                            -p 8080:80 \
                            ${env.IMAGE_URI}

                        sleep 10

                        STATUS=\$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/)
                        [ "\$STATUS" = "200" ] && echo "Root OK" || exit 1

                        curl -sf http://localhost:8080/ | grep -q "root" \
                            && echo "React app served" || exit 1

                        STATUS=\$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/cars)
                        [ "\$STATUS" = "200" ] && echo "React Router OK" || exit 1

                        echo "✅ Smoke test passed"
                    """
                }
            }
            post {
                always {
                    sh "docker rm -f frontend-smoke-${BUILD_NUMBER} || true"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 10 — Push to ECR
        // ─────────────────────────────────────────────────────
        stage('Stage 10 | Push to ECR') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    script {
                        sh """
                            aws ecr get-login-password --region ${AWS_REGION} | \
                                docker login \
                                    --username AWS \
                                    --password-stdin \
                                    ${env.ECR_REGISTRY}

                            docker tag ${env.IMAGE_URI} ${env.ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                            docker push ${env.IMAGE_URI}
                            docker push ${env.ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                            echo ${env.IMAGE_URI} > /tmp/frontend_image_uri.txt
                        """
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 11 — Upload Reports to S3
        // ─────────────────────────────────────────────────────
        stage('Stage 11 | Upload Reports to S3') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        R="car-frontend/build-${BUILD_NUMBER}"

                        [ -f trivy-report.json ] && \
                            aws s3 cp trivy-report.json s3://${S3_BUCKET}/${R}/trivy-report.json \
                            || echo "trivy-report.json not found, skipping"

                        [ -d car-frontend/dependency-check-report ] && \
                            aws s3 cp car-frontend/dependency-check-report/ \
                                s3://${S3_BUCKET}/${R}/sca/ --recursive \
                            || echo "OWASP report dir not found, skipping"

                        [ -f car-frontend/coverage/lcov.info ] && \
                            aws s3 cp car-frontend/coverage/lcov.info \
                                s3://${S3_BUCKET}/${R}/coverage/lcov.info \
                            || echo "lcov.info not found, skipping"

                        echo "✅ Reports upload complete → s3://${S3_BUCKET}/${R}/"
                    '''
                }
            }
        }

    }

    post {
        success {
            script {
                def imageUri = sh(script: 'cat /tmp/frontend_image_uri.txt', returnStdout: true).trim()
                echo "✅ CI passed — triggering CD with: ${imageUri}"
                build job: 'car-frontend-cd',
                      parameters: [string(name: 'IMAGE_URI', value: imageUri)],
                      wait: false
            }
        }
        failure {
            echo '❌ CI failed — CD will NOT be triggered'
        }
        always {
            sh 'docker image prune -f || true'
            sh 'rm -f /tmp/frontend_image_uri.txt trivy-report.json || true'
            cleanWs()
        }
    }

}
