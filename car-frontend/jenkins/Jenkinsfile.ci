// ─────────────────────────────────────────────────────────────
//  car-frontend — CI Pipeline
//
//  Stage 1 — Checkout
//  Stage 2 — Build          (injects REACT_APP_API_URL)
//  Stage 3 — Test + Coverage (60% threshold enforced)
//  Stage 4 — SCA             OWASP Dependency-Check
//  Stage 5 — SonarQube       SAST + SCA + Quality Gate
//  Stage 6 — Docker Build    build image locally
//  Stage 7 — Trivy Scan      image CVE scan
//  Stage 8 — Smoke Test      run nginx container + curl check
//  Stage 9 — Push to ECR     push image to AWS ECR
//
//  On success → triggers CD job automatically
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'   // ✅ Jenkins → Global Tool Configuration → NodeJS name
    }

    environment {
        SONAR_HOST_URL = 'http://your-sonar-server:9000'  // ✅ your SonarQube URL
        AWS_REGION     = 'ap-south-1'                     // ✅ your AWS region

        SONAR_TOKEN    = credentials('sonar-token')
        AWS_ACCOUNT_ID = credentials('aws-account-id')

        // ✅ Backend ALB DNS — set after backend is deployed
        // kubectl get svc car-backend -n autoelite → copy EXTERNAL-IP
        REACT_APP_API_URL = credentials('react-app-api-url')

        ECR_REPOSITORY = 'car-frontend'
        IMAGE_TAG      = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────
        // STAGE 1 — Checkout
        // ─────────────────────────────────────────────────────
        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
                echo "Branch: ${env.BRANCH_NAME}"
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 2 — Build
        // Writes REACT_APP_API_URL from Jenkins credential
        // into .env.production before npm run build.
        // React reads it and bakes it into the JS bundle.
        // npm install used (not npm ci) — works without lock file
        // ─────────────────────────────────────────────────────
        stage('Stage 2 | Build') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm install

                        echo "REACT_APP_API_URL=${REACT_APP_API_URL}" > .env.production

                        npm run build
                        echo "✅ Build complete"
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 3 — Test + Coverage
        //
        // Enforces 60% minimum coverage threshold.
        // Build fails if coverage drops below threshold.
        //
        // Generates:
        //   coverage/lcov.info      → SonarQube coverage tab
        //   coverage/junit.xml      → Jenkins test results chart
        //   coverage/lcov-report/   → Jenkins HTML coverage report
        // ─────────────────────────────────────────────────────
        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-frontend') {
                    sh '''
                        npm test -- \
                            --coverage \
                            --watchAll=false \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=clover \
                            --coverageThreshold='{"global":{"branches":60,"functions":60,"lines":60,"statements":60}}' \
                            --ci
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'car-frontend/coverage/junit.xml'

                    publishHTML([
                        allowMissing         : false,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'car-frontend/coverage/lcov-report',
                        reportFiles          : 'index.html',
                        reportName           : 'Frontend Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 4 — SCA (OWASP Dependency-Check)
        //
        // Scans all dependencies for known CVEs.
        // Fails build if CVSS score >= 9 (CRITICAL).
        //
        // Generates inside dependency-check-report/:
        //   .xml  → Jenkins trend chart
        //   .json → imported into SonarQube Security tab (Stage 5)
        //   .html → human readable report
        // ─────────────────────────────────────────────────────
        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                dir('car-frontend') {
                    dependencyCheck(
                        additionalArguments: '''
                            --scan .
                            --exclude node_modules
                            --format HTML
                            --format XML
                            --format JSON
                            --failOnCVSS 9
                            --enableRetired
                            --out dependency-check-report
                        ''',
                        odcInstallation: 'OWASP-DC'  // ✅ Jenkins → Global Tool Configuration → OWASP-DC name
                    )
                }
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern             : 'car-frontend/dependency-check-report/dependency-check-report.xml',
                        failedTotalCritical : 1,
                        failedTotalHigh     : 5
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 5 — SonarQube — SAST + SCA + Quality Gate
        //
        // Single SonarQube dashboard shows:
        //
        //   SAST → SonarQube built-in JS/React security rules:
        //          XSS, injection, hardcoded secrets, OWASP Top 10
        //          Visible: Dashboard → Issues → Security
        //
        //   SCA  → OWASP JSON imported via dependencyCheck property
        //          CVEs appear in Dashboard → Security → OWASP
        //
        //   Quality Gate → pass/fail combining SAST + SCA + Coverage
        //          Visible: Dashboard → Overview
        //          Pipeline blocks here until result arrives.
        //          Gate FAILS → Stage 6 never runs → no image built.
        // ─────────────────────────────────────────────────────
        stage('Stage 5 | SonarQube — SAST + Quality Gate') {
            steps {
                dir('car-frontend') {
                    withSonarQubeEnv('SonarQube') {  // ✅ Jenkins → Configure System → SonarQube Server name
                        sh '''
                            npx sonar-scanner \
                                -Dsonar.projectKey=car-frontend \
                                -Dsonar.projectName="Car Frontend" \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                \
                                -Dsonar.sources=src \
                                -Dsonar.exclusions=node_modules/**,build/**,coverage/**,**/*.test.js,**/*.test.jsx,dependency-check-report/** \
                                -Dsonar.tests=src \
                                -Dsonar.test.inclusions=**/*.test.js,**/*.test.jsx \
                                \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                \
                                -Dsonar.dependencyCheck.jsonReportPath=dependency-check-report/dependency-check-report.json \
                                -Dsonar.dependencyCheck.htmlReportPath=dependency-check-report/dependency-check-report.html \
                                \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                }
            }
            post {
                always {
                    timeout(time: 5, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: true
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 6 — Docker Build
        // ─────────────────────────────────────────────────────
        stage('Stage 6 | Docker Build') {
            steps {
                dir('car-frontend') {
                    script {
                        env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        env.IMAGE_URI    = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:prod-${IMAGE_TAG}"
                    }
                    sh 'docker build -t ${IMAGE_URI} .'
                    echo "Built: ${env.IMAGE_URI}"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 7 — Trivy Image Scan
        // Fails on HIGH or CRITICAL CVEs in the image.
        // ─────────────────────────────────────────────────────
        stage('Stage 7 | Trivy Scan') {
            steps {
                sh '''
                    echo "Running Trivy scan on ${IMAGE_URI}..."

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${IMAGE_URI}

                    echo "✅ Trivy scan passed"
                '''
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 8 — Smoke Test
        // Runs nginx container and confirms React app is served.
        // ─────────────────────────────────────────────────────
        stage('Stage 8 | Smoke Test') {
            steps {
                sh '''
                    echo "Starting smoke test container..."

                    docker run -d \
                        --name frontend-smoke-${BUILD_NUMBER} \
                        -p 8080:80 \
                        ${IMAGE_URI}

                    sleep 10

                    echo "--- Root page returns 200 ---"
                    STATUS=$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/)
                    [ "$STATUS" = "200" ] && echo "✅ Root page OK" || exit 1

                    echo "--- React root div present ---"
                    curl -sf http://localhost:8080/ | grep -q "root" \
                        && echo "✅ React app served" || exit 1

                    echo "--- React Router fallback ---"
                    STATUS=$(curl -o /dev/null -sw "%{http_code}" http://localhost:8080/cars)
                    [ "$STATUS" = "200" ] && echo "✅ React Router OK" || exit 1

                    echo "✅ Smoke test passed"

                    docker stop frontend-smoke-${BUILD_NUMBER}
                    docker rm   frontend-smoke-${BUILD_NUMBER}
                '''
            }
            post {
                always {
                    sh "docker rm -f frontend-smoke-${BUILD_NUMBER} || true"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 9 — Push to ECR
        // Only pushes after Trivy + smoke test pass.
        // ─────────────────────────────────────────────────────
        stage('Stage 9 | Push to ECR') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin \
                                ${ECR_REGISTRY}

                        docker tag ${IMAGE_URI} \
                            ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        docker push ${IMAGE_URI}
                        docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        echo "✅ Pushed: ${IMAGE_URI}"
                        echo "${IMAGE_URI}" > /tmp/frontend_image_uri.txt
                    '''
                }
            }
        }

    }

    post {
        success {
            script {
                def imageUri = sh(
                    script: 'cat /tmp/frontend_image_uri.txt',
                    returnStdout: true
                ).trim()
                echo "✅ CI passed — triggering CD with: ${imageUri}"
                build job: 'car-frontend-cd',
                      parameters: [string(name: 'IMAGE_URI', value: imageUri)],
                      wait: false
            }
        }
        failure {
            echo '❌ CI failed — CD will NOT be triggered'
        }
        always {
            sh 'docker image prune -f || true'
            sh 'rm -f /tmp/frontend_image_uri.txt || true'
            cleanWs()
        }
    }

}
