// ─────────────────────────────────────────────────────────────
//  car-backend — CD Pipeline (GitOps)
//
//  Triggered by: CI pipeline post { success }
//  Input:        IMAGE_URI from CI
//
//  Flow:
//    1. Clone GitHub repo
//    2. Update Kubernetes deployment YAML
//    3. Commit + Push changes
//    4. ArgoCD auto-syncs to EKS
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_URI',
            defaultValue: '',
            description: 'Full ECR image URI from CI pipeline'
        )
    }

    environment {
        IMAGE_URI     = "${params.IMAGE_URI}"
        GITHUB_REPO   = 'https://github.com/puttamoses/car-project-microservices.git'
        GITHUB_BRANCH = 'main'
        DEPLOY_FILE   = 'k8s/backend-deployment.yaml'
    }

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Stage 1 | Update K8s YAML & Push to GitHub') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        rm -rf gitops-repo

                        echo "Cloning repository..."

                        git clone https://${GIT_USER}:${GIT_PASS}@github.com/puttamoses/car-project-microservices.git gitops-repo

                        cd gitops-repo

                        git config user.email "jenkins-ci@autoelite.com"
                        git config user.name "Jenkins CI"

                        echo "Current image:"
                        grep "image:" ${DEPLOY_FILE}

                        echo "Updating deployment YAML..."

                        sed -i "/image:/c\\        image: ${IMAGE_URI}" ${DEPLOY_FILE}

                        echo "Updated image:"
                        grep "image:" ${DEPLOY_FILE}

                        git add ${DEPLOY_FILE}

                        if git diff --cached --quiet
                        then
                            echo "No changes detected."
                        else
                            git commit -m "cd: update car-backend image to ${IMAGE_URI} [build ${BUILD_NUMBER}]"

                            git push origin ${GITHUB_BRANCH}

                            echo "✅ Changes pushed successfully"
                        fi

                        echo "✅ ArgoCD will sync automatically"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "✅ CD complete — ArgoCD will deploy ${IMAGE_URI}"
        }

        failure {
            echo "❌ CD failed — YAML not updated"
        }

        always {
            sh 'rm -rf gitops-repo || true'
            cleanWs()
        }
    }
}
