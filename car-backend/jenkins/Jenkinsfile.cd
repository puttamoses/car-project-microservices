// ─────────────────────────────────────────────────────────────
//  car-backend — CD Pipeline (GitOps)
//
//  Triggered by: CI pipeline post { success } automatically
//  Input:        IMAGE_URI from CI (read from /tmp/backend_image_uri.txt)
//
//  How it works:
//    1. Receives IMAGE_URI from CI build job trigger
//    2. Validates IMAGE_URI is not empty
//    3. Clones GitOps repo with PAT credentials
//    4. Updates image tag in k8s/backend-deployment.yaml
//    5. Commits & pushes only if change detected
//    6. ArgoCD detects push → auto-syncs to EKS
//
//  ✅ Jenkins Setup Required:
//    Manage Jenkins → Credentials
//      → github-creds  (Username + PAT as password)
//
//  ✅ Jenkins Job Setup:
//    This job name MUST be: car-backend-cd
//    (must match exactly what CI calls in build job: 'car-backend-cd')
// ─────────────────────────────────────────────────────────────
pipeline {

    agent any

    parameters {
        string(
            name        : 'IMAGE_URI',
            defaultValue: '',
            description : 'Full ECR image URI passed automatically from CI pipeline. Example: 339918905923.dkr.ecr.ap-south-1.amazonaws.com/car-backend:1-abc1234'
        )
    }

    environment {
        IMAGE_URI     = "${params.IMAGE_URI}"
        GITHUB_BRANCH = 'main'
        DEPLOY_FILE   = 'k8s/backend-deployment.yaml'
    }

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────
        // STAGE 0 — Validate
        // Ensures IMAGE_URI was passed from CI.
        // If empty it means pipeline was triggered manually
        // without a parameter — abort immediately.
        // ─────────────────────────────────────────────────────
        stage('Stage 0 | Validate Input') {
            steps {
                script {
                    if (!env.IMAGE_URI?.trim()) {
                        error('''
IMAGE_URI is empty.
This pipeline must be triggered automatically by car-backend CI.
If testing manually:
  → Jenkins UI → car-backend-cd → Build with Parameters
  → Set IMAGE_URI to a valid ECR image URI
                        ''')
                    }
                    echo "📦 Image to deploy : ${env.IMAGE_URI}"
                    echo "📁 File to update  : ${env.DEPLOY_FILE}"
                    echo "🌿 Target branch   : ${env.GITHUB_BRANCH}"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 1 — Update K8s YAML & Push to GitHub
        //
        // Clones the GitOps repo, updates the image tag in
        // backend-deployment.yaml, and pushes the change.
        // ArgoCD watches this repo and syncs automatically.
        //
        // sed uses | as delimiter because IMAGE_URI contains /
        // Double-quoted sh block so Groovy interpolates
        // IMAGE_URI and BUILD_NUMBER before shell executes.
        // GIT_USER / GIT_PASS are shell vars from withCredentials
        // so they are escaped with \$ to prevent Groovy touching them.
        // ─────────────────────────────────────────────────────
        stage('Stage 1 | Update K8s YAML & Push to GitHub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId   : 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )
                ]) {
                    sh """
                        set -e

                        # ── Clean any leftover clone ──────────────────────
                        rm -rf gitops-repo

                        # ── Clone GitOps repo with PAT embedded in URL ────
                        echo "Cloning GitOps repository..."
                        git clone https://\${GIT_USER}:\${GIT_PASS}@github.com/puttamoses/car-project-microservices.git gitops-repo

                        cd gitops-repo

                        # ── Identity for the commit ───────────────────────
                        git config user.email "jenkins-ci@autoelite.com"
                        git config user.name  "Jenkins CI"

                        # ── Show current image before change ──────────────
                        echo "Current image in YAML:"
                        grep "image:" ${env.DEPLOY_FILE}

                        # ── Replace image line ────────────────────────────
                        # Uses | as sed delimiter because ECR URIs contain /
                        # Matches only lines referencing car-backend image
                        sed -i "s|image:.*car-backend.*|image: ${env.IMAGE_URI}|g" ${env.DEPLOY_FILE}

                        # ── Show updated image after change ───────────────
                        echo "Updated image in YAML:"
                        grep "image:" ${env.DEPLOY_FILE}

                        # ── Commit only if file actually changed ──────────
                        git add ${env.DEPLOY_FILE}

                        if git diff --cached --quiet; then
                            echo "⚠️  No changes detected — image tag already up to date"
                        else
                            git commit -m "cd: update car-backend image to ${env.IMAGE_URI} [ci-build-${env.BUILD_NUMBER}]"
                            git push origin ${env.GITHUB_BRANCH}
                            echo "✅ Pushed to GitHub — ArgoCD will sync automatically"
                        fi
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ CD complete — ArgoCD is deploying: ${env.IMAGE_URI}"
        }
        failure {
            echo "❌ CD failed — YAML was not updated. Check logs above."
        }
        always {
            sh 'rm -rf gitops-repo || true'
            cleanWs()
        }
    }
}
