pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_URI',
            defaultValue: '',
            description: 'Full ECR image URI from CI pipeline'
        )

        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'GitOps repo branch'
        )
    }

    environment {
        GIT_REPO     = 'git@github.com:your-org/car-backend-k8s.git'
        GIT_DIR      = 'car-backend-k8s'
        DEPLOY_FILE  = 'k8s/deployment.yaml'
        IMAGE_URI    = "${params.IMAGE_URI}"
    }

    options {
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────
        stage('Checkout GitOps Repo') {
            steps {
                sh '''
                    rm -rf ${GIT_DIR}
                    git clone ${GIT_REPO}
                '''
            }
        }

        // ─────────────────────────────
        stage('Update Kubernetes Manifest') {
            steps {
                dir("${GIT_DIR}") {
                    sh '''
                        echo "🔄 Updating image in deployment.yaml"

                        sed -i "s|image: .*|image: ${IMAGE_URI}|g" ${DEPLOY_FILE}

                        echo "✅ Updated file:"
                        cat ${DEPLOY_FILE}
                    '''
                }
            }
        }

        // ─────────────────────────────
        stage('Commit Changes to GitHub') {
            steps {
                dir("${GIT_DIR}") {
                    withCredentials([usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh '''
                            git config user.email "ci@pipeline.com"
                            git config user.name "jenkins-ci"

                            git add .
                            git commit -m "🚀 Update image to ${IMAGE_URI}" || echo "No changes to commit"

                            git push https://${GIT_USER}:${GIT_PASS}@github.com/your-org/car-backend-k8s.git ${GIT_BRANCH}
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────
        stage('Verify Push') {
            steps {
                echo "📦 Image updated in GitOps repo"
                echo "⏳ ArgoCD will auto-sync to EKS"
            }
        }
    }

    post {

        success {
            echo "✅ GitOps CD completed — ArgoCD will handle deployment"
        }

        failure {
            echo "❌ GitOps update failed — check repo push"
        }

        always {
            cleanWs()
        }
    }
}
