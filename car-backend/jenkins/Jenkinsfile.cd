// ─────────────────────────────────────────────────────────────
//  car-backend — CD Pipeline
//
//  Triggered by: CI pipeline post { success }
//  Input:        IMAGE_URI from CI
//
//  Stage 1 — Deploy to EKS
//
//  ✅ Jenkins Setup Required:
//    Manage Jenkins → Credentials
//      → aws-credentials (AWS Credentials)
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    parameters {
        string(
            name        : 'IMAGE_URI',
            defaultValue: '',
            description : 'Full ECR image URI passed from CI pipeline'
        )
    }

    environment {
        AWS_REGION    = 'ap-south-1'         // ✅ your AWS region
        EKS_CLUSTER   = 'autoelite-cluster'  // ✅ your EKS cluster name
        K8S_NAMESPACE = 'autoelite'
        IMAGE_URI     = "${params.IMAGE_URI}"
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Stage 1 | Deploy to EKS') {
            steps {
                echo "🚀 Deploying ${IMAGE_URI} to namespace: ${K8S_NAMESPACE}"
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        aws eks update-kubeconfig \
                            --name ${EKS_CLUSTER} \
                            --region ${AWS_REGION}

                        kubectl set image deployment/car-backend \
                            car-backend=${IMAGE_URI} \
                            -n ${K8S_NAMESPACE}

                        kubectl rollout status deployment/car-backend \
                            -n ${K8S_NAMESPACE} \
                            --timeout=120s

                        echo "✅ Deployment complete"
                        kubectl get pods -n ${K8S_NAMESPACE} -l app=car-backend
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "✅ CD complete — ${IMAGE_URI} is live"
        }
        failure {
            echo '❌ Deploy failed — rolling back...'
            withCredentials([[
                $class       : 'AmazonWebServicesCredentialsBinding',
                credentialsId: 'aws-credentials'
            ]]) {
                sh '''
                    aws eks update-kubeconfig \
                        --name ${EKS_CLUSTER} \
                        --region ${AWS_REGION} || true
                    kubectl rollout undo deployment/car-backend \
                        -n ${K8S_NAMESPACE} || true
                    echo "✅ Rolled back"
                '''
            }
        }
        always {
            cleanWs()
        }
    }

}
