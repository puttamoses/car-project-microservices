// ─────────────────────────────────────────────────────────────
//  car-backend — CI Pipeline
//
//  Stage 1  — Checkout
//  Stage 2  — Build
//  Stage 3  — Test + Coverage
//  Stage 4  — SCA  (OWASP Dependency-Check)
//  Stage 5  — SAST (SonarQube Scan)
//  Stage 6  — Quality Gate (HARD STOP)
//  Stage 7  — Docker Build
//  Stage 8  — Trivy Image Scan (HARD STOP)
//  Stage 9  — Smoke Test
//  Stage 10 — Push to ECR
//  Stage 11 — Upload Reports to S3
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        SONAR_HOST_URL = 'http://13.200.38.79:9000'   // ✅ your SonarQube URL
        AWS_REGION     = 'ap-south-1'                 // ✅ your AWS region
        S3_BUCKET      = 'your-reports-bucket'        // ✅ your S3 bucket name

        SONAR_TOKEN    = credentials('sonar-token')
        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REPOSITORY = 'car-backend'
        IMAGE_TAG      = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────
        // STAGE 1 — Checkout
        // ─────────────────────────────────────────────────────
        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 2 — Build
        // ─────────────────────────────────────────────────────
        stage('Stage 2 | Build') {
            steps {
                dir('car-backend') {
                    sh 'npm install'
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 3 — Test + Coverage
        // ─────────────────────────────────────────────────────
        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-backend') {
                    sh '''
                        npm test -- \
                            --coverage \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --forceExit \
                            --ci
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'car-backend/coverage/junit.xml'
                    publishHTML([
                        allowMissing         : false,
                        alwaysLinkToLastBuild: true,
                        keepAll              : true,
                        reportDir            : 'car-backend/coverage/lcov-report',
                        reportFiles          : 'index.html',
                        reportName           : 'Backend Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 4 — SCA (OWASP Dependency-Check)
        //
        // dependencyCheck() always runs from WORKSPACE root
        // regardless of dir() — must use absolute paths.
        //
        // ✅ Jenkins setup:
        //    Manage Jenkins → Global Tool Configuration
        //    → Dependency-Check → Name: OWASP-DC → Install automatically
        // ─────────────────────────────────────────────────────
        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                script {
                    def reportDir = "${WORKSPACE}/dependency-check-report"
                    def scanDir   = "${WORKSPACE}/car-backend"
                    sh "mkdir -p ${reportDir}"
                    dependencyCheck(
                        additionalArguments: [
                            "--project car-backend",
                            "--scan ${scanDir}",
                            "--exclude **/.git/**",
                            "--exclude **/node_modules/**",
                            "--exclude **/coverage/**",
                            "--exclude **/dependency-check-report/**",
                            "--format XML",
                            "--format HTML",
                            "--format JSON",
                            "--out ${reportDir}",
                            "--failOnCVSS 9",
                            "--disableAssembly",
                            "--disableNodeAudit"
                        ].join(' '),
                        odcInstallation: 'OWASP-DC'
                    )
                    sh "ls -lh ${reportDir} || true"
                }
            }
            post {
                always {
                    dependencyCheckPublisher(
                        pattern: 'dependency-check-report/dependency-check-report.xml'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 5 — SAST (SonarQube Scan)
        //
        // Sends source code + coverage + OWASP JSON to SonarQube.
        // Does NOT wait for result here — Stage 6 does that.
        // ─────────────────────────────────────────────────────
        stage('Stage 5 | SAST — SonarQube Scan') {
            steps {
                dir('car-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            npx sonar-scanner \
                                -Dsonar.projectKey=car-backend \
                                -Dsonar.projectName="Car Backend" \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                -Dsonar.sources=. \
                                -Dsonar.exclusions=node_modules/**,coverage/**,**/*.test.js,dependency-check-report/** \
                                -Dsonar.tests=. \
                                -Dsonar.test.inclusions=**/*.test.js \
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 6 — Quality Gate (HARD STOP)
        //
        // Reads ceTaskId from .scannerwork/report-task.txt
        // Polls SonarQube API every 10s until task finishes
        // Then checks Quality Gate status
        // Fails pipeline if gate is not OK
        //
        // Uses $SONAR_TOKEN safely in shell (no Groovy interpolation)
        // Uses ${taskId} in Groovy (not a secret, safe to interpolate)
        // ─────────────────────────────────────────────────────
        stage('Stage 6 | Quality Gate — HARD STOP') {
            steps {
                script {
                    // Read task ID written by sonar-scanner
                    def reportTaskFile = 'car-backend/.scannerwork/report-task.txt'
                    def taskId = readFile(reportTaskFile)
                        .split('\n')
                        .find { it.startsWith('ceTaskId=') }
                        ?.replace('ceTaskId=', '')
                        ?.trim()

                    if (!taskId) {
                        error "ceTaskId not found in ${reportTaskFile}"
                    }

                    echo "Polling SonarQube task: ${taskId}"

                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {

                        def sonarUrl   = env.SONAR_HOST_URL
                        def maxWaitSec = 300   // 5 minutes
                        def waited     = 0
                        def status     = ''

                        // Poll until task is no longer PENDING or IN_PROGRESS
                        while (waited < maxWaitSec) {
                            sleep 10
                            waited += 10

                            def raw = sh(
                                script: """curl -sf -u "\$SONAR_TOKEN:" "${sonarUrl}/api/ce/task?id=${taskId}" """,
                                returnStdout: true
                            ).trim()

                            status = readJSON(text: raw).task.status
                            echo "Attempt ${waited/10} — Status: ${status}"

                            if (!(status in ['PENDING', 'IN_PROGRESS'])) {
                                break
                            }
                        }

                        // Check final status
                        if (status != 'SUCCESS') {
                            error "SonarQube task failed or timed out — final status: ${status}"
                        }

                        // Get Quality Gate result
                        def gateRaw = sh(
                            script: """curl -sf -u "\$SONAR_TOKEN:" "${sonarUrl}/api/qualitygates/project_status?projectKey=car-backend" """,
                            returnStdout: true
                        ).trim()

                        def gateStatus = readJSON(text: gateRaw).projectStatus.status
                        echo "Quality Gate: ${gateStatus}"

                        if (gateStatus != 'OK') {
                            error "Quality Gate FAILED: ${gateStatus} — check ${sonarUrl}/dashboard?id=car-backend"
                        }

                        echo 'Quality Gate PASSED'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 7 — Docker Build
        // ─────────────────────────────────────────────────────
        stage('Stage 7 | Docker Build') {
            steps {
                script {
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI    = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                }
                sh 'docker build -t ${IMAGE_URI} car-backend/'
                echo "Built: ${env.IMAGE_URI}"
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 8 — Trivy Image Scan (HARD STOP)
        //
        // Scans Docker image for OS + library CVEs.
        // --ignore-unfixed skips CVEs with no fix yet (reduces noise).
        // Fails on HIGH or CRITICAL.
        // ─────────────────────────────────────────────────────
        stage('Stage 8 | Trivy Image Scan — HARD STOP') {
            steps {
                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --ignore-unfixed \
                        --no-progress \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_URI}

                    echo "Trivy scan passed"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 9 — Smoke Test
        // ─────────────────────────────────────────────────────
        stage('Stage 9 | Smoke Test') {
            steps {
                sh '''
                    docker run -d \
                        --name backend-smoke-${BUILD_NUMBER} \
                        -p 5000:5000 \
                        -e PORT=5000 \
                        ${IMAGE_URI}

                    sleep 10

                    curl -f http://localhost:5000/health   || exit 1
                    curl -f http://localhost:5000/api/cars || exit 1

                    echo "Smoke test passed"
                '''
            }
            post {
                always {
                    sh "docker rm -f backend-smoke-${BUILD_NUMBER} || true"
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 10 — Push to ECR
        // ─────────────────────────────────────────────────────
        stage('Stage 10 | Push to ECR') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin \
                                ${ECR_REGISTRY}

                        docker tag ${IMAGE_URI} ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        docker push ${IMAGE_URI}
                        docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest

                        echo "Pushed: ${IMAGE_URI}"
                        echo "${IMAGE_URI}" > /tmp/backend_image_uri.txt
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────
        // STAGE 11 — Upload Reports to S3
        // ─────────────────────────────────────────────────────
        stage('Stage 11 | Upload Reports to S3') {
            steps {
                withCredentials([[
                    $class       : 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        REPORT_PATH="car-backend/build-${BUILD_NUMBER}"

                        aws s3 cp trivy-report.json \
                            s3://${S3_BUCKET}/${REPORT_PATH}/trivy-report.json || true

                        aws s3 cp dependency-check-report/ \
                            s3://${S3_BUCKET}/${REPORT_PATH}/sca/ --recursive || true

                        aws s3 cp car-backend/coverage/lcov.info \
                            s3://${S3_BUCKET}/${REPORT_PATH}/coverage/lcov.info || true

                        echo "Reports uploaded to s3://${S3_BUCKET}/${REPORT_PATH}/"
                    '''
                }
            }
        }

    }

    post {
        success {
            script {
                def imageUri = sh(
                    script: 'cat /tmp/backend_image_uri.txt',
                    returnStdout: true
                ).trim()
                echo "CI passed — triggering CD with: ${imageUri}"
                build job: 'car-backend-cd',
                      parameters: [string(name: 'IMAGE_URI', value: imageUri)],
                      wait: false
            }
        }
        failure {
            echo 'CI failed — CD will NOT be triggered'
        }
        always {
            sh 'docker image prune -f || true'
            sh 'rm -f /tmp/backend_image_uri.txt trivy-report.json || true'
            cleanWs()
        }
    }

}
