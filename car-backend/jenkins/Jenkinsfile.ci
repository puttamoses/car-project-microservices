// ─────────────────────────────────────────────────────────────
//  car-backend — CI Pipeline
// ─────────────────────────────────────────────────────────────

pipeline {

    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        SONAR_HOST_URL = 'http://your-sonar-server:9000'
        AWS_REGION     = 'ap-south-1'
        S3_BUCKET      = 'your-reports-bucket'

        SONAR_TOKEN    = credentials('sonar-token')
        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REPOSITORY = 'car-backend'
        IMAGE_TAG      = "${env.BUILD_NUMBER}-${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'nohash'}"
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {

        stage('Stage 1 | Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Stage 2 | Build') {
            steps {
                dir('car-backend') {
                    sh 'npm install'
                }
            }
        }

        stage('Stage 3 | Test & Coverage') {
            steps {
                dir('car-backend') {
                    sh '''
                        npm test -- --coverage --ci --forceExit
                    '''
                }
            }
        }

        stage('Stage 4 | SCA — OWASP Dependency-Check') {
            steps {
                dir('car-backend') {
                    dependencyCheck(
                        additionalArguments: '''
                            --project car-backend
                            --scan .
                            --exclude **/.git/**
                            --exclude **/node_modules/**
                            --exclude **/coverage/**
                            --exclude **/dependency-check-report/**
                            --format ALL
                            --out dependency-check-report
                            --failOnCVSS 9
                            --disableNodeAudit
                        ''',
                        odcInstallation: 'OWASP-DC'
                    )
                }
            }

            post {
                always {
                    dependencyCheckPublisher pattern: 'car-backend/dependency-check-report/*.xml'
                }
            }
        }

        stage('Stage 5 | SAST — SonarQube Scan') {
            steps {
                dir('car-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            npx sonar-scanner \
                            -Dsonar.projectKey=car-backend \
                            -Dsonar.projectName="Car Backend" \
                            -Dsonar.sources=. \
                            -Dsonar.exclusions=node_modules/**,coverage/**,**/*.test.js,dependency-check-report/** \
                            -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                            -Dsonar.host.url=${SONAR_HOST_URL} \
                            -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        // ✅ FIXED STAGE 6 (your exact style kept)
        stage('Stage 6 | Quality Gate — HARD STOP') {
            steps {
                script {
                    timeout(time: 20, unit: 'MINUTES') {
                        def qg = waitForQualityGate()

                        echo "🔎 Quality Gate Status: ${qg.status}"

                        if (qg.status != 'OK') {
                            error "❌ Quality Gate Failed: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Stage 7 | Docker Build') {
            steps {
                script {
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI = "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                }

                sh 'docker build -t ${IMAGE_URI} car-backend'
            }
        }

        stage('Stage 8 | Trivy Image Scan — HARD STOP') {
            steps {
                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --ignore-unfixed \
                        --format json \
                        --output trivy-report.json \
                        ${IMAGE_URI}
                '''
            }

            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.json', allowEmptyArchive: true
                }
            }
        }

        stage('Stage 9 | Smoke Test') {
            steps {
                sh '''
                    docker run -d --name smoke-${BUILD_NUMBER} -p 5000:5000 ${IMAGE_URI}
                    sleep 10
                    curl -f http://localhost:5000/health
                '''
            }

            post {
                always {
                    sh 'docker rm -f smoke-${BUILD_NUMBER} || true'
                }
            }
        }

        stage('Stage 10 | Push to ECR') {
            steps {
                withCredentials([[class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        docker push ${IMAGE_URI}
                    '''
                }
            }
        }

        stage('Stage 11 | Upload Reports to S3') {
            steps {
                withCredentials([[class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    sh '''
                        REPORT_PATH="car-backend/build-${BUILD_NUMBER}"

                        aws s3 cp trivy-report.json s3://${S3_BUCKET}/${REPORT_PATH}/ || true

                        aws s3 cp car-backend/dependency-check-report/ \
                            s3://${S3_BUCKET}/${REPORT_PATH}/sca/ --recursive || true

                        aws s3 cp car-backend/coverage/lcov.info \
                            s3://${S3_BUCKET}/${REPORT_PATH}/coverage/ || true
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI SUCCESS"
        }

        failure {
            echo "❌ CI FAILED"
        }

        always {
            cleanWs()
        }
    }
}
