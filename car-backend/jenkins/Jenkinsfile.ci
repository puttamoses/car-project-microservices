pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        ECR_REPOSITORY = 'car-backend'
        IMAGE_TAG      = "${BUILD_NUMBER}"

        SONAR_HOST_URL = 'http://your-sonarqube-server:9000'
    }

    stages {

        // ─────────────────────────────
        stage('Stage 1 - Checkout') {
            steps {
                checkout scm
            }
        }

        // ─────────────────────────────
        stage('Stage 2 - Build') {
            steps {
                dir('car-backend') {
                    sh 'npm install'
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 3 - Test + Coverage') {
            steps {
                dir('car-backend') {
                    sh 'npm test -- --coverage'
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 4 - SCA (Dependency Check)') {
            steps {
                dir('car-backend') {
                    sh '''
                        dependency-check.sh \
                        --project car-backend \
                        --scan . \
                        --format ALL \
                        --out sca-report \
                        --failOnCVSS 7
                    '''
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 5 - SAST (SonarQube Scan)') {
            steps {
                dir('car-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            npx sonar-scanner \
                              -Dsonar.projectKey=car-backend \
                              -Dsonar.projectName="Car Backend" \
                              -Dsonar.sources=. \
                              -Dsonar.tests=. \
                              -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 6 - Quality Gate (HARD STOP)') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 7 - Docker Build') {
            steps {
                dir('car-backend') {
                    sh """
                        docker build -t ${ECR_REPOSITORY}:${IMAGE_TAG} .
                    """
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 8.1 - SBOM Generation (Syft)') {
            steps {
                dir('car-backend') {
                    sh """
                        syft ${ECR_REPOSITORY}:${IMAGE_TAG} -o json > sbom.json
                        syft ${ECR_REPOSITORY}:${IMAGE_TAG} -o table > sbom.txt
                    """
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 8.2 - Upload SBOM to S3') {
            steps {
                sh """
                    aws s3 cp car-backend/sbom.json s3://your-bucket/sbom/${BUILD_NUMBER}.json
                    aws s3 cp car-backend/sbom.txt s3://your-bucket/sbom/${BUILD_NUMBER}.txt
                """
            }
        }

        // ─────────────────────────────
        stage('Stage 9 - Trivy Image Scan (HARD STOP)') {
            steps {
                dir('car-backend') {
                    sh """
                        trivy image \
                          --exit-code 1 \
                          --severity CRITICAL,HIGH \
                          -f json \
                          -o trivy-report.json \
                          ${ECR_REPOSITORY}:${IMAGE_TAG}
                    """

                    sh """
                        aws s3 cp trivy-report.json s3://your-bucket/trivy-reports/${BUILD_NUMBER}.json
                    """
                }
            }
        }

        // ─────────────────────────────
        stage('Stage 10 - Smoke Test') {
            steps {
                sh """
                    docker run -d --name car-backend-test -p 3000:3000 ${ECR_REPOSITORY}:${IMAGE_TAG}
                    sleep 10
                    curl -f http://localhost:3000/health
                    docker stop car-backend-test
                    docker rm car-backend-test
                """
            }
        }

        // ─────────────────────────────
        stage('Stage 11 - Push to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin <account>.dkr.ecr.${AWS_REGION}.amazonaws.com

                    docker tag ${ECR_REPOSITORY}:${IMAGE_TAG} \
                    <account>.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}

                    docker push <account>.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}
                """
            }
        }
    }

    // ─────────────────────────────
    post {
        success {
            echo "✅ Pipeline SUCCESS"
        }

        failure {
            echo "❌ Pipeline FAILED - check logs"
        }

        always {
            echo "🏁 Pipeline completed"
        }
    }
}
